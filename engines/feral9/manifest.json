{
 "schema": "cycles-mod/0.1",
 "id": "feral9",
 "version": "9",
 "name": "Feral machine: nine noisy, unpredictable synthesis models",
 "description": "One extra machine after Chord with nine models on SHAPE: NYB (bytebeat), GND (Gendy), BNJ (Benjolin), RYT (Rhythmicon resonators), FRS (Fourses), RNG (a HAVOC rungler), PLS (pulsar), SCN (scanned synthesis) and KOS (logistic map). COLOR and SWEEP are the model's two macros, CONTOUR the tone envelope (a third control on BNJ and RNG), PUNCH is FREE, DECAY and GATE as on Tone.",
 "license": "MIT",
 "credit": {
  "kind": "own",
  "who": "100demons and Claude"
 },
 "source": "this engine folder (src/), first published in cycles-mods",
 "device": "Model:Cycles",
 "os": "1.13",
 "order": 64,
 "build": {
  "sources": [
   "src/tiny2.c"
  ],
  "include": [
   "src"
  ],
  "cflags": [
   "-mcpu=54418",
   "-O2",
   "-malign-int",
   "-U_FORTIFY_SOURCE",
   "-ffreestanding",
   "-fno-builtin",
   "-fno-tree-loop-distribute-patterns",
   "-nostdlib",
   "-fno-pic",
   "-fno-common",
   "-ffunction-sections",
   "-fdata-sections",
   "-fomit-frame-pointer",
   "-fwrapv",
   "-Wall",
   "-Wextra",
   "-Werror"
  ],
  "defines": {
   "CM_SYMBOLS": "1"
  },
  "objects": [
   "addon/feral9.o"
  ],
  "symbols": {
   "update": "tiny2_update",
   "render": "tiny2_render"
  },
  "keep": [],
  "patch_points": [
   {
    "symbol": "cm_descriptor_base",
    "kind": "descriptor_base"
   }
  ]
 },
 "uses": [
  {
   "point": "machine",
   "name": "Feral",
   "image": 4,
   "decay_default": 50,
   "knobs": [
    {
     "long": "Color",
     "short": "COLR",
     "default": 64,
     "min": 0,
     "max": 127
    },
    {
     "long": "Model",
     "short": "MODL",
     "default": 0,
     "min": 0,
     "max": 8
    },
    {
     "long": "Sweep",
     "short": "SWP",
     "default": 64,
     "min": 0,
     "max": 127
    },
    {
     "long": "Contour",
     "short": "CNT",
     "default": 64,
     "min": 0,
     "max": 127
    }
   ]
  }
 ],
