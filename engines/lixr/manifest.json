{
 "schema": "cycles-mod/0.1",
 "id": "lixr",
 "version": "3",
 "name": "LiXR machine: fixed-point drum voice with a decimator instead of the filter",
 "description": "A clean-room drum voice in the spirit of the Sonic Potions LXR drum voices: one tableless oscillator with feedback FM, a noise/transient layer, a pitch envelope, a sample-and-rate decimator driven by CONTOUR and a soft saturator. Four knobs (COLOR, SHAPE, SWEEP, RATE) plus the stock PITCH, DECAY, PUNCH, GATE and FINE.",
 "license": "MIT",
 "credit": {"kind": "own", "who": "100demons and Claude"},
